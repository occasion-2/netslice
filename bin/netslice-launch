#!/bin/bash
# Usage: netslice-launch <command> [args...]

CONFIG_FILE="@@SYSCONFDIR@@/netslice.conf"
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
elif [ -f "/etc/netslice.conf" ]; then
    source "/etc/netslice.conf"
fi
: "${NETSLICE_SLICE:=system-netslice.slice}"

USER_ID=$(id -u)
GROUP_ID=$(id -g)
RUNTIME_DIR="/run/user/$USER_ID"

# 3. Build Environment Arguments
ENV_ARGS=()
[ -n "$DISPLAY" ] && ENV_ARGS+=("--setenv=DISPLAY=$DISPLAY")
[ -n "$WAYLAND_DISPLAY" ] && ENV_ARGS+=("--setenv=WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
[ -n "$XAUTHORITY" ] && ENV_ARGS+=("--setenv=XAUTHORITY=$XAUTHORITY")
[ -n "$XDG_RUNTIME_DIR" ] && ENV_ARGS+=("--setenv=XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR")
[ -n "$XDG_SESSION_TYPE" ] && ENV_ARGS+=("--setenv=XDG_SESSION_TYPE=$XDG_SESSION_TYPE")
[ -n "$XDG_CURRENT_DESKTOP" ] && ENV_ARGS+=("--setenv=XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP")

# Force Wayland optimizations and US localization
ENV_ARGS+=("--setenv=ELECTRON_OZONE_PLATFORM_HINT=auto")
ENV_ARGS+=("--setenv=TZ=America/New_York")
ENV_ARGS+=("--setenv=LANG=en_US.UTF-8")

# Force Xray Proxy fallbacks natively
ENV_ARGS+=("--setenv=HTTP_PROXY=http://127.0.0.1:10808")
ENV_ARGS+=("--setenv=HTTPS_PROXY=http://127.0.0.1:10808")

# IMPORTANT: Notice DBUS_SESSION_BUS_ADDRESS is intentionally missing

# 4. Execute with Systemd and Bubblewrap
exec sudo systemd-run \
    --description="Netslice Proxied App" \
    --slice="$NETSLICE_SLICE" \
    --scope \
    --uid="$USER_ID" \
    --gid="$GROUP_ID" \
    "${ENV_ARGS[@]}" \
    -- \
    bwrap \
    --dev-bind / / \
    --unshare-ipc \
    --ro-bind /usr/share/zoneinfo/America/New_York /etc/localtime \
    --ro-bind /dev/null /etc/machine-id \
    --ro-bind /dev/null "$RUNTIME_DIR/bus" \
    --die-with-parent -- "$@"
