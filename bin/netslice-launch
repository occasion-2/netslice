#!/bin/bash
# Usage: netslice-launch [--routing-only] [--allow_dbus] [--] <command> [args...]

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: netslice-launch [--routing-only] [--allow_dbus] [--] <command> [args...]

Options:
  --routing-only  Use cgroup routing without Bubblewrap isolation.
  --allow_dbus  Allow access to the host user session D-Bus.
  -h, --help    Show this help message.
EOF
}

ALLOW_DBUS=0
ROUTING_ONLY=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --routing-only)
            ROUTING_ONLY=1
            shift
            ;;
        --allow_dbus)
            ALLOW_DBUS=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf 'netslice-launch: unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -eq 0 ]; then
    printf 'netslice-launch: missing command\n' >&2
    usage >&2
    exit 2
fi

CONFIG_FILE="@@SYSCONFDIR@@/netslice.conf"

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
elif [ -f "/etc/netslice.conf" ]; then
    # shellcheck disable=SC1091
    source "/etc/netslice.conf"
fi

: "${NETSLICE_SLICE:=system-netslice.slice}"
: "${NETSLICE_PROXY_HOST:=127.0.0.1}"
: "${NETSLICE_PROXY_PORT:=10808}"
: "${NETSLICE_TZ:=America/New_York}"
: "${NETSLICE_LANG:=en_US.UTF-8}"

USER_ID="$(id -u)"
GROUP_ID="$(id -g)"
RUNTIME_DIR="/run/user/$USER_ID"

# Build systemd environment arguments.
ENV_ARGS=()

[ -n "${DISPLAY:-}" ] && ENV_ARGS+=("--setenv=DISPLAY=$DISPLAY")
[ -n "${WAYLAND_DISPLAY:-}" ] && ENV_ARGS+=("--setenv=WAYLAND_DISPLAY=$WAYLAND_DISPLAY")
[ -n "${XAUTHORITY:-}" ] && ENV_ARGS+=("--setenv=XAUTHORITY=$XAUTHORITY")
[ -n "${XDG_RUNTIME_DIR:-}" ] && ENV_ARGS+=("--setenv=XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR")
[ -n "${XDG_SESSION_TYPE:-}" ] && ENV_ARGS+=("--setenv=XDG_SESSION_TYPE=$XDG_SESSION_TYPE")
[ -n "${XDG_CURRENT_DESKTOP:-}" ] && ENV_ARGS+=("--setenv=XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP")
[ -n "${DESKTOP_SESSION:-}" ] && ENV_ARGS+=("--setenv=DESKTOP_SESSION=$DESKTOP_SESSION")

# Electron / Chromium hints.
ENV_ARGS+=("--setenv=ELECTRON_OZONE_PLATFORM_HINT=auto")
if [ "$ROUTING_ONLY" -eq 0 ]; then
    ENV_ARGS+=("--setenv=TZ=$NETSLICE_TZ")
elif [ -n "${TZ:-}" ]; then
    ENV_ARGS+=("--setenv=TZ=$TZ")
fi
# ENV_ARGS+=("--setenv=LANG=$NETSLICE_LANG")

# Preserve basic user/session env needed by Electron, SSH, askpass, shells.
for v in \
    HOME USER LOGNAME PATH SHELL \
    TERM COLORTERM \
    LANG LC_ALL LC_CTYPE \
    SSH_AUTH_SOCK SSH_AGENT_PID \
    XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_DATA_DIRS; do
    if [ -n "${!v:-}" ]; then
        ENV_ARGS+=("--setenv=$v=${!v}")
    fi
done

# Proxy fallback for apps/components that honor environment proxies.
# Transparent cgroup/TUN routing should also work independently.
PROXY_URL="http://${NETSLICE_PROXY_HOST}:${NETSLICE_PROXY_PORT}"

# Both modes keep the same routing scope and launch as the invoking user.
SYSTEMD_ARGS=(
    --description="Netslice Proxied App"
    --slice="$NETSLICE_SLICE"
    --scope
)

# systemd-run --scope --uid/--gid can retain sudo's supplementary groups.
# Drop credentials explicitly, initializing the user's groups before any app
# (or Bubblewrap) runs. Use a fixed path because this step starts as root.
USER_ARGS=(
    /usr/bin/setpriv
    --reuid="$USER_ID"
    --regid="$GROUP_ID"
    --init-groups
    --inh-caps=-all
    --ambient-caps=-all
    --
)

if [ "$ROUTING_ONLY" -eq 1 ]; then
    # Preserve the host bus address across sudo/systemd. No socket is hidden.
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        ENV_ARGS+=("--setenv=DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS")
    fi
    exec sudo systemd-run "${SYSTEMD_ARGS[@]}" "${ENV_ARGS[@]}" -- "${USER_ARGS[@]}" "$@"
fi

# Bubblewrap refuses to mount directly on /etc/localtime when it is a symlink.
# Bind the fake timezone over the symlink's resolved regular-file target instead.
LOCALTIME_TARGET="$(readlink -f /etc/localtime)"
NETSLICE_TZ_FILE="$(readlink -f "/usr/share/zoneinfo/$NETSLICE_TZ")"

# Persistent fake machine-id.
# Do NOT bind /dev/null to /etc/machine-id; Electron may use machine-id-derived storage.
FAKE_CONFIG_DIR="$HOME/.config/netslice"
FAKE_MACHINE_ID_FILE="$FAKE_CONFIG_DIR/fake-machine-id"

mkdir -p "$FAKE_CONFIG_DIR"

if [ ! -f "$FAKE_MACHINE_ID_FILE" ]; then
    openssl rand -hex 16 > "$FAKE_MACHINE_ID_FILE"
    chmod 600 "$FAKE_MACHINE_ID_FILE"
fi

# Hide the host user session bus unless access was explicitly requested. Set
# the opt-in environment inside bwrap so it cannot be lost at the sudo/systemd
# boundary.
BWRAP_DBUS_ARGS=(
    --unsetenv DBUS_SESSION_BUS_ADDRESS
    --ro-bind /dev/null "$RUNTIME_DIR/bus"
)
if [ "$ALLOW_DBUS" -eq 1 ]; then
    BWRAP_DBUS_ARGS=(
        --setenv XDG_RUNTIME_DIR "$RUNTIME_DIR"
        --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$RUNTIME_DIR/bus"
    )
fi

exec sudo systemd-run "${SYSTEMD_ARGS[@]}" "${ENV_ARGS[@]}" -- "${USER_ARGS[@]}" \
    bwrap \
    --dev-bind / / \
    --ro-bind "$NETSLICE_TZ_FILE" "$LOCALTIME_TARGET" \
    --ro-bind "$FAKE_MACHINE_ID_FILE" /etc/machine-id \
    "${BWRAP_DBUS_ARGS[@]}" \
    --die-with-parent \
    -- "$@"
