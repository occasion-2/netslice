[Unit]
Description=Netslice IPv4 routing reconciliation (firewall has separate ownership)
Wants=netslice-firewall.service xray.service
After=netslice-firewall.service xray.service

[Service]
Type=exec
ExecStart=@@PREFIX@@/bin/netslice-control routing-watch
ExecStopPost=@@PREFIX@@/bin/netslice-control routing-stop
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=75s
RuntimeDirectory=netslice
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
