# /etc/nftables/netslice.nft

table inet netslice_cgroup
flush table inet netslice_cgroup

table inet netslice_cgroup {
    chain mark_out {
        type route hook output priority mangle; policy accept;

        # Never mark localhost/proxy/internal IDE traffic.
        oifname "lo" accept

        # Mark everything from the netslice cgroup.
        socket cgroupv2 level 2 $SLICE_PATH meta mark set $FWMARK counter
    }

    chain kill_post {
        type filter hook postrouting priority filter; policy accept;

        # After policy routing has happened, kill marked packets
        # that still try to leave outside the TUN.
        meta mark $FWMARK oifname != $TUN_DEV counter drop
    }
}
