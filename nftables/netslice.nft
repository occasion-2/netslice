# Rendered by netslice-control; never load this template directly.
# The old inet netslice_cgroup table is left intact during migration.
table inet netslice_guard {
    comment "@IDENTITY@"
    chain mark_out {
        type route hook output priority -150; policy accept;
        oifname "lo" accept
        meta nfproto ipv4 socket cgroupv2 level 2 @CGROUP_ID@ meta mark set @FWMARK@ counter
    }
    chain guard_out {
        type filter hook output priority 0; policy accept;
        oifname "lo" accept
        socket cgroupv2 level 2 @CGROUP_ID@ meta nfproto ipv6 counter drop
        # Independent of the routing mark. Output oifname is the original route.
        socket cgroupv2 level 2 @CGROUP_ID@ meta priority set 0x4e530001 counter
    }
    chain kill_post {
        type filter hook postrouting priority 0; policy accept;
        oifname "lo" accept
        meta priority 0x4e530001 oifname != "@TUN_DEV@" counter drop
        meta mark @FWMARK@ oifname != "@TUN_DEV@" counter drop
    }
}
